{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "queroconhecer.cancandles.com.br"
        }
      ],
      "destination": "/conheca",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|assets/).*)",
      "has": [
        {
          "type": "host",
          "value": "queroconhecer.cancandles.com.br"
        }
      ],
      "destination": "/indicacao.html"
    },
    {
      "source": "/indicacao/:codigo",
      "destination": "/indicacao.html"
    },
    {
      "source": "/((?!api/|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
